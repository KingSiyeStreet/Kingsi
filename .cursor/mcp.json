{
  "mcpServers": {
    "x": {
      "type": "http",
      "url": "https://api.x.com/mcp",
      "auth": {
        "CLIENT_ID": "${env:X_OAUTH_CLIENT_ID}",
        "CLIENT_SECRET": "${env:X_OAUTH_CLIENT_SECRET}",
        "scopes": [
          "tweet.read",
          "users.read",
          "follows.read",
          "space.read",
          "mute.read",
          "like.read",
          "list.read",
          "list.write",
          "block.read",
          "block.write",
          "bookmark.read",
          "bookmark.write",
          "billing.write",
          "offline.access"
        ]
      }
    }
  }
}
